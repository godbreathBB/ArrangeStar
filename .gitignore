# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 构建产物（由 npm run build 生成，不入库）──────────
dist/
build/
bundle.js
js/data.js

# ── 环境变量（.env.example 模板保留在仓库中）──────────
.env
.env.local
.env.*.local

# ── 日志与缓存 ────────────────────────────────────────
*.log
.cache/

# ── 系统与编辑器 ──────────────────────────────────────
.DS_Store
.vscode/
.idea/

# ── 数据库与密钥（不应出现在仓库中）──────────────────
*.db
*.sqlite
*.sqlite3
*.pem
*.key
